{
    "name": "@ts-core/crypto-metamask-frontend",
    "version": "3.1.2",
    "description": "Frontend TypeScript library for signing and verifying messages with the MetaMask wallet in the browser using personal_sign (EIP-191)",
    "main": "./cjs/public-api.js",
    "module": "./esm/public-api.js",
    "exports": {
        ".": {
            "import": "./esm/public-api.js",
            "require": "./cjs/public-api.js"
        }
    },
    "scripts": {},
    "author": {
        "name": "Renat Gubaev",
        "email": "renat.gubaev@gmail.com"
    },
    "license": "ISC",
    "dependencies": {
        "@ts-core/common": "~3.0.57"
    },
    "devDependencies": {
        "@types/node": "^14.14.31",
        "gulp-npm-module-publisher": "^3.0.0"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ManhattanDoctor/ts-core-crypto-metamask-frontend.git"
    },
    "keywords": [
        "typescript",
        "metamask",
        "ethereum",
        "web3",
        "crypto",
        "signature",
        "personal-sign",
        "eip-191",
        "wallet",
        "frontend",
        "authentication"
    ],
    "bugs": {
        "url": "https://github.com/ManhattanDoctor/ts-core-crypto-metamask-frontend/issues"
    },
    "homepage": "https://github.com/ManhattanDoctor/ts-core-crypto-metamask-frontend#readme"
}
